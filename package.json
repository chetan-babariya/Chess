{
  "name": "chess-live-app",
  "version": "1.0.0",
  "description": "Production-ready real-time multiplayer chess game for local LAN and cloud deployment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "bot": "node bot.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/style.css --watch",
    "build": "npm run build:css"
  },
  "keywords": [
    "chess",
    "multiplayer",
    "socket.io",
    "express",
    "lan"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chess.js": "^1.0.0-beta.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "node-telegram-bot-api": "0.66.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
