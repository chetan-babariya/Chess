PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Comma-separated allowed origins for CORS (leave empty for permissive dev mode)
# ALLOWED_ORIGINS=https://chess.example.com,http://localhost:3000
# Max rooms a single IP can create simultaneously
MAX_ROOMS_PER_IP=5
# Room time-to-live in ms after all players disconnect (default 1 hour)
ROOM_TTL_MS=3600000
